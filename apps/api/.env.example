# ---- Runtime ----
NODE_ENV=development
PORT=3001

# ---- Banco (PostgreSQL / Neon) ----
DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot?schema=public

# ---- Auth ----
JWT_SECRET=troque-por-um-segredo-forte-com-32+caracteres
JWT_EXPIRES_IN=1d

# Google OAuth 2.0 (login com Google normal). Crie o Client no console.cloud.google.com.
# A redirect URI autorizada deve ser: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Groq (LLM) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=25000

# ---- Prompt / CORS ----
PROMPT_VERSION=v1
WEB_ORIGIN=http://localhost:3000
