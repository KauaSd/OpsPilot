# URL base da API NestJS, incluindo o prefixo global da API (Server-only, nunca prefixe com NEXT_PUBLIC)
# Ex.: https://opspilot-api.onrender.com/api/v1
API_URL=http://localhost:3001/api/v1

# Ativar mocks server-side e client-side para desenvolvimento e demonstração
NEXT_PUBLIC_USE_MOCKS=true

# Google OAuth 2.0: client ID (público) usado pelo BFF para iniciar o login com Google.
# Somente necessário quando NEXT_PUBLIC_USE_MOCKS=false (produção).
GOOGLE_CLIENT_ID=
