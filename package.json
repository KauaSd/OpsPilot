{
  "name": "opspilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:web": "pnpm --filter @opspilot/web dev",
    "dev:api": "pnpm --filter @opspilot/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "contracts:export": "pnpm --filter @opspilot/api contracts:export"
  }
}
